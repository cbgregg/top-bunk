// macOS depot: the universal electron-builder "dir" output (npm run dist:mac on a Mac -> dist/mac/Top Bunk.app).
// One bundle with x64 and arm64 slices, so it runs natively on Intel Macs and on Apple silicon. electron-builder
// would name the folder mac-universal; "defaultArch": "universal" in package.json keeps it at dist/mac/.
// libsteam_api.dylib is already universal and steamworks.js picks its darwin-x64 or darwin-arm64 .node at run time.
// Upload this depot from macOS or Linux so executable bits inside the bundle survive (Windows drops them).
// Launch option in Steamworks: executable "Top Bunk.app/Contents/MacOS/Top Bunk", OS macOS.
"DepotBuild"
{
	"DepotID" "YOUR_DEPOT_ID_MAC"

	// Overrides AppBuild/ContentRoot; relative to this file. Contains "Top Bunk.app".
	"ContentRoot" "../dist/mac/"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}

	"FileExclusion" "*.DS_Store"
	"FileExclusion" "*.map"
	"FileExclusion" "*.log"
	"FileExclusion" "*/steamworks.js/dist/win64/*"
	"FileExclusion" "*/steamworks.js/dist/linux64/*"
}
